---
import type { ImageMetadata } from 'astro';
import { Font, Image } from 'astro:assets';
import SocialLinks from '../components/SocialLinks.astro';
import { profile } from '../data';
import '../styles/global.css';

interface Props {
  pageTitle: string;
}

const { pageTitle } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const title = pageTitle === 'About'
  ? `${profile.name} — ${profile.role}`
  : `${pageTitle} — ${profile.name}`;
const navigation = [
  { label: 'About', href: '/' },
  { label: 'Work', href: '/work' },
  { label: 'Background', href: '/experience' },
  { label: 'Achievements', href: '/achievements' },
  { label: 'Resume', href: '/resume' },
];
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/*.{jpeg,jpg,png,webp}', { eager: true });
const localImage = (filename: string) => {
  const image = images[`/src/assets/images/${filename}`]?.default;
  if (!image) throw new Error(`Image not found: src/assets/images/${filename}`);
  return image;
};
const portraitImage = localImage(profile.portraitSrc);
const portraitFrame = localImage(profile.portraitFrameSrc);
const footerIllustration = localImage(profile.footerIllustrationSrc);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FFFFFF" />
    <meta name="description" content={profile.intro} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={profile.intro} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-geist-mono" preload />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-intro">
        <div class="intro-top">
          <button
            class="portrait-hanger"
            type="button"
            aria-label={`Straighten portrait: ${profile.portraitAlt}`}
            aria-pressed="false"
            title="Straighten portrait"
            data-portrait-hanger
            data-description={profile.portraitAlt}
          >
            <span class="framed-portrait" aria-hidden="true">
              <Image class="portrait-image" src={portraitImage} alt="" width={320} format="webp" loading="eager" />
              <Image class="portrait-frame" src={portraitFrame} alt="" width={480} format="png" loading="eager" />
            </span>
          </button>
          <SocialLinks />
        </div>
        <h1>I'm <span class="name">{profile.name}</span>, a {profile.role}.</h1>
        <p class="intro-copy">{profile.intro}</p>
      </header>

      <nav class="section-nav" aria-label="Portfolio pages">
        {navigation.map((link) => (
          <a href={link.href} aria-current={pathname === link.href ? 'page' : undefined}>{link.label}</a>
        ))}
      </nav>

      <main id="main">
        <div class="section-heading">
          <h2>{pageTitle}</h2>
        </div>
        <slot />
      </main>

      <footer class="site-footer">
        <div class="footer-location">
          <span>{profile.location}</span>
          <time data-kochi-time data-time-zone={profile.timeZone} aria-label={`Current time in ${profile.location}`}>IST</time>
        </div>
        <Image class="footer-illustration" src={footerIllustration} alt="" width={256} format="webp" loading="eager" />
        <SocialLinks />
      </footer>
    </div>
    <script>
      const hanger = document.querySelector<HTMLButtonElement>('[data-portrait-hanger]');
      if (hanger) {
        const setFixed = (fixed: boolean) => {
          const action = fixed ? 'Let portrait hang' : 'Straighten portrait';
          hanger.setAttribute('aria-pressed', String(fixed));
          hanger.setAttribute('aria-label', `${action}: ${hanger.dataset.description}`);
          hanger.title = action;
          try {
            sessionStorage.setItem('portrait-fixed', String(fixed));
          } catch {
            // The interaction still works when session storage is unavailable.
          }
        };

        let fixed = false;
        try {
          fixed = sessionStorage.getItem('portrait-fixed') === 'true';
        } catch {
          // Keep the default hanging state.
        }
        setFixed(fixed);
        hanger.dataset.ready = 'true';
        hanger.addEventListener('click', () => setFixed(hanger.getAttribute('aria-pressed') !== 'true'));
      }

      const clock = document.querySelector<HTMLTimeElement>('[data-kochi-time]');
      if (clock) {
        const formatter = new Intl.DateTimeFormat('en-IN', {
          timeZone: clock.dataset.timeZone,
          hour: 'numeric',
          minute: '2-digit',
          hour12: true,
        });
        const updateClock = () => {
          const now = new Date();
          clock.dateTime = now.toISOString();
          clock.textContent = `${formatter.format(now)} IST`;
        };
        updateClock();
        window.setInterval(updateClock, 60_000);
      }
    </script>
  </body>
</html>
