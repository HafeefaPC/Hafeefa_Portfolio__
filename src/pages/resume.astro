---
import Layout from '../layouts/Layout.astro';

const resumeUrl = '/Hafeefa-PC-Resume.pdf';
---

<Layout pageTitle="Resume">
  <section class="resume-viewer" aria-labelledby="resume-heading">
    <div class="resume-toolbar">
      <div class="resume-info">
        <h3 id="resume-heading">Hafeefa PC — Resume</h3>
        <p>AI/ML Engineer · PDF Document</p>
      </div>

      <a
        class="resume-download"
        href={resumeUrl}
        download="Hafeefa-PC-Resume.pdf"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <path d="m7 10 5 5 5-5" />
          <path d="M12 15V3" />
        </svg>
        Download PDF
      </a>
    </div>

    <div class="pdf-container">
      <object
        data={resumeUrl}
        type="application/pdf"
        class="pdf-frame"
        aria-label="Resume PDF preview"
      >
        <div class="pdf-fallback">
          <p>Your browser cannot display the PDF preview.</p>
          <a href={resumeUrl} target="_blank" rel="noreferrer">
            Open resume PDF
          </a>
        </div>
      </object>
    </div>

    <p class="resume-note">
      Prefer a separate view?
      <a href={resumeUrl} target="_blank" rel="noreferrer">
        Open resume in a new tab ↗
      </a>
    </p>
  </section>
</Layout>

<style>
  .resume-viewer {
    width: 100%;
    min-width: 0;
  }

  .resume-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .resume-info h3 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
  }

  .resume-info p {
    margin: 0.35rem 0 0;
    font-size: 0.85rem;
    opacity: 0.7;
  }

  .resume-download {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.7rem 1rem;
    border: 1px solid currentColor;
    border-radius: 8px;
    color: inherit;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: opacity 160ms ease;
  }

  .resume-download:hover {
    opacity: 0.7;
  }

  .pdf-container {
    width: 100%;
    height: min(78vh, 1050px);
    min-height: 500px;
    overflow: hidden;
    border: 1px solid var(--color-border, #dedede);
    border-radius: 10px;
    background: #f5f5f5;
  }

  .pdf-frame {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .pdf-fallback {
    padding: 2rem;
    text-align: center;
    color: #222;
  }

  .pdf-fallback a,
  .resume-note a {
    text-underline-offset: 3px;
  }

  .resume-note {
    margin-top: 1rem;
    font-size: 0.875rem;
    opacity: 0.8;
  }

  @media (max-width: 600px) {
    .resume-toolbar {
      align-items: flex-start;
    }

    .resume-download {
      width: 100%;
    }

    .pdf-container {
      height: 70vh;
      min-height: 420px;
    }
  }
</style>