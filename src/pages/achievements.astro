---
import Layout from '../layouts/Layout.astro';
import { achievements } from '../data';
---

<Layout pageTitle="Achievements">
  <section
    class="content-section"
    aria-labelledby="achievements-title"
  >
    <div class="section-heading">
      <h3 id="achievements-title">Recognition & Achievements</h3>
    </div>

    <div class="entry-list">
      {achievements.map((achievement) => (
        <article class="entry">
          <div class="entry-top">
            <h4>{achievement.title}</h4>
            <span class="entry-date">{achievement.date}</span>
          </div>

          <p class="entry-meta">{achievement.organization}</p>
          <p>{achievement.description}</p>
          <span class="achievement-category">
            {achievement.category}
          </span>

          {achievement.url && (
            <a class="secondary-link" href={achievement.url}>
              View achievement ↗
            </a>
          )}
        </article>
      ))}
    </div>
  </section>
</Layout>

<style>
  .achievement-category {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--color-border, #ddd);
    border-radius: 999px;
    font-size: 0.8rem;
  }
</style>